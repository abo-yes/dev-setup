# Repository-managed Zsh configuration. Oh My Zsh must be loaded first.

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

[[ -r "$ZSH/oh-my-zsh.sh" ]] || {
  echo "Oh My Zsh is missing. Run ./shell/setup.sh" >&2
  return 1
}
source "$ZSH/oh-my-zsh.sh"

# History shared across sessions.
HIST_STAMPS="yyyy-mm-dd"
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE INC_APPEND_HISTORY

# Safer, convenient defaults.
alias ll='ls -lah'
alias la='ls -A'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --decorate --graph -20'
alias ..='cd ..'
alias ...='cd ../..'

export EDITOR="${EDITOR:-vim}"
export VISUAL="${VISUAL:-$EDITOR}"

# Keep local machine overrides out of this repository.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
